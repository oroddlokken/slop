#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = ["rich", "textual>=7,<8"]
# ///
"""Browse the Claude Code memories belonging to the current git repo.

Usage: claudemem [-A] [--json]

Opens a two-pane TUI: the repo's memories on the left, the selected file on
the right. Arrows navigate, e opens the file in $EDITOR, D deletes it, u undoes
the last delete, r reloads, q quits.

-A/--all browses every project's memories at once, grouped under project
headers. --json prints the same memories on stdout instead of starting the TUI.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

from rich.syntax import Syntax
from rich.text import Text
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Horizontal, VerticalScroll
from textual.widgets import Footer, Header, Label, ListItem, ListView, Static

# The order the memory types are grouped in; anything else sorts after these.
TYPE_ORDER = ("user", "feedback", "project", "reference")

# MEMORY.md is the index Claude Code loads each session, not a memory itself.
INDEX_NAME = "MEMORY.md"

# The slug a project directory is named after is lossy, so the launch directory
# is recovered from a session transcript instead. `cwd` sits on ordinary
# records, not on a header, so a few lines of scanning are needed to reach one.
CWD_SCAN_FILES = 3
CWD_SCAN_LINES = 200


@dataclass
class Memory:
    path: Path
    name: str
    type: str
    description: str
    project: str = ""

    @property
    def mem_dir(self) -> Path:
        return self.path.parent

    def read(self) -> str:
        return self.path.read_text()


def parse_frontmatter(text: str) -> tuple[str, str]:
    """Pull `description` and `metadata.type` out of a memory's frontmatter."""
    type_ = ""
    description = ""
    fences = 0
    for line in text.splitlines():
        if line.strip() == "---":
            fences += 1
            if fences == 2:
                break
            continue
        if line.startswith("description:"):
            description = line.removeprefix("description:").strip()
            if description.startswith('"') and description.endswith('"'):
                description = description[1:-1].replace('\\"', '"')
        elif line.strip().startswith("type:"):
            type_ = line.split("type:", 1)[1].strip()
    return type_ or "unknown", description


def repo_root() -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return Path.cwd()
    return Path(result.stdout.strip())


def projects_dir() -> Path:
    return Path.home() / ".claude" / "projects"


def memory_dir(root: Path) -> Path:
    # Claude Code keys each project's storage on the launch directory with every
    # non-alphanumeric character replaced by a dash.
    slug = re.sub(r"[^a-zA-Z0-9]", "-", str(root))
    return projects_dir() / slug / "memory"


def session_cwd(project_dir: Path) -> str | None:
    """Recover the launch directory from one of the project's transcripts."""
    transcripts = sorted(
        project_dir.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True
    )
    for transcript in transcripts[:CWD_SCAN_FILES]:
        try:
            with transcript.open() as handle:
                for line, _ in zip(handle, range(CWD_SCAN_LINES)):
                    try:
                        record = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if isinstance(record, dict) and record.get("cwd"):
                        return record["cwd"]
        except OSError:
            continue
    return None


def display_path(path: str) -> str:
    home = str(Path.home())
    return "~" + path[len(home) :] if path.startswith(home) else path


def unslug(slug: str) -> str | None:
    """Walk the filesystem to turn a slug back into the path it was made from.

    Dashes stand for both slashes and literal dashes, so each step takes the
    longest segment that exists on disk. A project whose directory is gone
    cannot be resolved this way and gives None.
    """
    path = Path("/")
    parts = [part for part in slug.split("-") if part]
    index = 0
    while index < len(parts):
        for end in range(len(parts), index, -1):
            candidate = path / "-".join(parts[index:end])
            if candidate.is_dir():
                path, index = candidate, end
                break
        else:
            return None
    return str(path)


def project_label(project_dir: Path) -> str:
    """A readable name for a project directory, however little is left of it."""
    cwd = session_cwd(project_dir) or unslug(project_dir.name)
    if cwd is not None:
        return display_path(cwd)
    home_slug = re.sub(r"[^a-zA-Z0-9]", "-", str(Path.home()))
    if project_dir.name.startswith(home_slug):
        return "~/" + project_dir.name[len(home_slug) :].lstrip("-")
    return project_dir.name


def sort_key(memory: Memory) -> tuple[str, int, str, str]:
    rank = TYPE_ORDER.index(memory.type) if memory.type in TYPE_ORDER else len(TYPE_ORDER)
    return (memory.project, rank, memory.type, memory.name)


def load_memories(mem_dir: Path, project: str = "") -> list[Memory]:
    memories = []
    for path in mem_dir.glob("*.md"):
        if path.name == INDEX_NAME:
            continue
        type_, description = parse_frontmatter(path.read_text())
        memories.append(Memory(path, path.stem, type_, description, project))
    return sorted(memories, key=sort_key)


def load_all_memories() -> list[Memory]:
    """Every project's memories, ordered so each project's block stays together."""
    memories = []
    root = projects_dir()
    if not root.is_dir():
        return memories
    for project_dir in sorted(root.iterdir()):
        mem_dir = project_dir / "memory"
        if not mem_dir.is_dir():
            continue
        memories.extend(load_memories(mem_dir, project_label(project_dir)))
    return sorted(memories, key=sort_key)


def drop_index_line(mem_dir: Path, name: str) -> tuple[int, str] | None:
    """Remove `name`'s pointer from MEMORY.md so the index keeps no dead links."""
    index = mem_dir / INDEX_NAME
    if not index.exists():
        return None
    lines = index.read_text().splitlines(keepends=True)
    for i, line in enumerate(lines):
        if f"({name}.md)" in line:
            lines.pop(i)
            index.write_text("".join(lines))
            return (i, line)
    return None


def restore_index_line(mem_dir: Path, position: int, line: str) -> None:
    index = mem_dir / INDEX_NAME
    lines = index.read_text().splitlines(keepends=True) if index.exists() else []
    lines.insert(min(position, len(lines)), line)
    index.write_text("".join(lines))


class MemoryItem(ListItem):
    def __init__(self, memory: Memory, name_col: int, indent: str = "") -> None:
        label = Text.assemble(
            indent, memory.name.ljust(name_col), "  ", (memory.type, "dim italic")
        )
        super().__init__(Label(label))
        self.memory = memory


class ProjectItem(ListItem):
    """A group header. Disabled so the cursor jumps over it while navigating."""

    def __init__(self, project: str, count: int) -> None:
        label = Text.assemble((project, "bold"), " ", (f"({count})", "dim"))
        super().__init__(Label(label), classes="project", disabled=True)


class ClaudeMem(App[None]):
    CSS = """
    #memories {
        width: auto;
        /* A long project header would otherwise push the list half the screen
           wide, so names clip instead of the preview shrinking. */
        max-width: 44;
        border-right: solid $panel;
    }
    #memories Label {
        text-overflow: ellipsis;
    }
    #memories > .project {
        color: $accent;
        text-opacity: 100%;
        margin-top: 1;
    }
    #memories > .project.-first {
        margin-top: 0;
    }
    #preview {
        padding: 0 1;
    }
    """

    BINDINGS = [
        Binding("e", "edit", "Edit"),
        Binding("D", "delete", "Delete"),
        Binding("u", "undo", "Undo"),
        Binding("r", "reload", "Reload"),
        Binding("q", "quit", "Quit"),
    ]

    def __init__(
        self,
        name: str,
        load: Callable[[], list[Memory]],
        grouped: bool = False,
    ) -> None:
        super().__init__()
        self.project_name = name
        self.load = load
        self.grouped = grouped
        self.memories: list[Memory] = []
        # (memory, file text, index position, index line) per delete, newest last.
        self.deleted: list[tuple[Memory, str, int | None, str | None]] = []

    def compose(self) -> ComposeResult:
        yield Header()
        with Horizontal():
            yield ListView(id="memories")
            with VerticalScroll():
                yield Static(id="preview")
        yield Footer()

    async def on_mount(self) -> None:
        self.title = self.project_name
        await self.action_reload()
        self.query_one(ListView).focus()

    @property
    def current(self) -> Memory | None:
        item = self.query_one(ListView).highlighted_child
        return item.memory if isinstance(item, MemoryItem) else None

    def build_items(self) -> list[ListItem]:
        name_col = max((len(m.name) for m in self.memories), default=0)
        if not self.grouped:
            return [MemoryItem(m, name_col) for m in self.memories]

        counts: dict[str, int] = {}
        for memory in self.memories:
            counts[memory.project] = counts.get(memory.project, 0) + 1

        items: list[ListItem] = []
        project = None
        for memory in self.memories:
            if memory.project != project:
                project = memory.project
                header = ProjectItem(project, counts[project])
                if not items:
                    header.add_class("-first")
                items.append(header)
            items.append(MemoryItem(memory, name_col, indent="  "))
        return items

    async def action_reload(self, keep_index: int | None = None) -> None:
        listview = self.query_one(ListView)
        if keep_index is None:
            keep_index = listview.index or 0
        self.memories = self.load()
        self.sub_title = f"{len(self.memories)} memories"
        if self.grouped:
            projects = len({m.project for m in self.memories})
            self.sub_title += f" in {projects} projects"

        items = self.build_items()
        await listview.clear()
        await listview.extend(items)
        selectable = [i for i, item in enumerate(items) if isinstance(item, MemoryItem)]
        if selectable:
            # The remembered position may now hold a header, so settle on the
            # nearest memory at or after it, else the last one.
            keep_index = max(0, min(keep_index, len(items) - 1))
            listview.index = next(
                (i for i in selectable if i >= keep_index), selectable[-1]
            )
            # Landing on the same index leaves the watcher silent, so a delete
            # would keep the gone file on screen.
            self.show_preview(self.current)
        else:
            self.show_preview(None)

    def on_list_view_highlighted(self, event: ListView.Highlighted) -> None:
        self.show_preview(event.item.memory if isinstance(event.item, MemoryItem) else None)

    def show_preview(self, memory: Memory | None) -> None:
        preview = self.query_one("#preview", Static)
        if memory is None:
            empty = "No memories found." if self.grouped else "No memories for this repo."
            preview.update(Text(empty, style="dim"))
            return
        preview.update(
            Syntax(
                memory.read(),
                "markdown",
                word_wrap=True,
                background_color="default",
            )
        )

    async def action_edit(self) -> None:
        memory = self.current
        if memory is None:
            return
        editor = shlex.split(os.environ.get("EDITOR", "vi"))
        with self.suspend():
            subprocess.call([*editor, str(memory.path)])
        await self.action_reload()

    async def action_delete(self) -> None:
        memory = self.current
        if memory is None:
            return
        text = memory.read()
        dropped = drop_index_line(memory.mem_dir, memory.name)
        memory.path.unlink()
        position, line = dropped if dropped else (None, None)
        self.deleted.append((memory, text, position, line))
        await self.action_reload()
        self.notify(f"Deleted {memory.name} — u to undo")

    async def action_undo(self) -> None:
        if not self.deleted:
            self.notify("Nothing to undo", severity="warning")
            return
        memory, text, position, line = self.deleted.pop()
        memory.path.write_text(text)
        if line is not None:
            restore_index_line(memory.mem_dir, position, line)
        await self.action_reload()
        self.notify(f"Restored {memory.name}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "-A",
        "--all",
        action="store_true",
        help="browse every project's memories, grouped by project",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="print the memories as JSON instead of starting the TUI",
    )
    args = parser.parse_args()

    if args.all:
        name, load = "All projects", load_all_memories
    else:
        root = repo_root()
        mem_dir = memory_dir(root)
        project = display_path(str(root))
        name = root.name

        def load() -> list[Memory]:
            return load_memories(mem_dir, project) if mem_dir.is_dir() else []

    memories = load()

    if args.json:
        json.dump(
            [
                {
                    "name": m.name,
                    "type": m.type,
                    "description": m.description,
                    "project": m.project,
                    "path": str(m.path),
                    "body": m.read(),
                }
                for m in memories
            ],
            sys.stdout,
            indent=2,
        )
        sys.stdout.write("\n")
        return 0

    if not memories:
        where = str(projects_dir()) if args.all else str(mem_dir)
        print(f"No memories for {name} ({where})")
        return 0

    ClaudeMem(name, load, grouped=args.all).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
